# Server-side secrets only. Never commit .env.local or put these in NEXT_PUBLIC_*.
# Empty Qloo key in development uses MOCK_SIMULATED. Production requires a real key.
QLOO_API_KEY=

# Optional Gemini. Leave empty to use disclosed local rules, with no LLM provider call.
# Activate only with explicit cost authorization and an enabled model ID for the account.
GEMINI_API_KEY=
GEMINI_MODEL=

# Do not set NODE_ENV here: Next.js sets development/production for its own command.
# Dedicated live test opt-in (not a runtime production setting): QLOO_LIVE_TESTS=1
